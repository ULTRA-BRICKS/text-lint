#!/usr/bin/env python3
# Thin shim for a symlink install path (the symlink must resolve back to the
# repo to find the text_lint package). pipx/uv installs use [project.scripts]
# text-lint = "text_lint.cli:main" and never run this file. Keep it MINIMAL.
import os
import sys

_root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if os.path.isfile(os.path.join(_root, "text_lint", "__init__.py")):
    sys.path.insert(0, _root)

from text_lint.cli import main  # noqa: E402

raise SystemExit(main())
