#!/usr/bin/env python3
"""Fake `aiw-ru` for unit tests: `scan --json --context X` on stdin, real JSON shape.

FAKE_AIWRU_LOG=<file> appends the argv and the received text as one JSON line.
"""
import json
import os
import re
import sys

PATTERNS = [
    ("tier1", "в-современном-мире", "P1", r"[Вв] современном мире", "убрать и начать с сути", False),
    ("chatbot", "надеюсь-поможет", "P0", r"Надеюсь, это поможет", "удалить", False),
    ("tier1-clarity", "данный", "P2", r"[Дд]анный подход", "«этот»", True),
]

args = sys.argv[1:]
text = sys.stdin.read()
if os.environ.get("FAKE_AIWRU_LOG"):
    with open(os.environ["FAKE_AIWRU_LOG"], "a", encoding="utf-8") as log:
        log.write(json.dumps({"argv": args, "text": text}, ensure_ascii=False) + "\n")
if os.environ.get("FAKE_AIWRU_OUTPUT") is not None:
    print(os.environ["FAKE_AIWRU_OUTPUT"])
    sys.exit(0)
issues = []
for type_, rule, severity, pattern, hint, style_only in PATTERNS:
    for m in re.finditer(pattern, text):
        line = text.count("\n", 0, m.start()) + 1
        column = m.start() - (text.rfind("\n", 0, m.start()) + 1) + 1
        issue = {"type": type_, "rule": rule, "severity": severity, "text": m.group(0),
                 "index": m.start(), "line": line, "column": column, "hint": hint}
        if style_only:
            issue["styleOnly"] = True
        issues.append(issue)
words = len(re.findall(r"\w+", text))
print(json.dumps({"file": "<stdin>", "score": 60 if issues else 0, "label": "fake",
                  "issues": issues, "stats": {"words": words}}, ensure_ascii=False))
